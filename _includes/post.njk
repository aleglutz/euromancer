<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · euromancer</title>
  <link rel="stylesheet" href="{{ '/css/styles.css' | url }}">
</head>
<body>
  <header>
    <p class="last-login">Last login: <ac>{{ null | renderDate }}</ac> on ttys000</p>
    {% set headline = title | tdfiglet(cover_font or "forgotex") %}
    <h1 class="post-figlet" style="--cols: {{ headline | maxcols }}"><pre>{{ headline }}</pre></h1>
    <nav><a href="{{ '/' | url }}">home</a> <a href="{{ '/archive/' | url }}">texts+images</a> <span class="active">{{ page.fileSlug }}.md</span></nav>
  </header>

  <main>
    {% set parentUrl = page.url | replace(page.fileSlug + '/', '') %}
    {% set attachmentsUrl = (parentUrl + 'attachments/') | url %}
    <article class="slides">
      {% if subtitle or tags or cover_image %}
      <section class="slide slide--cover"{% if cover_image %} style="background-image: url('{{ attachmentsUrl }}{{ cover_image }}')"{% endif %}>
        <p class="subtitle">{{ subtitle }}</p>
        <p class="topics">topics:
          {% for tag in tags %}
            <a href="{{ ('/archive/tag/' + tag + '/') | url }}">{{ tag }}</a>{% if not loop.last %} | {% endif %}
          {% endfor %}
        </p>
      </section>
      {% endif %}
      {{ content | safe }}
    </article>
  </main>

  {% include "footer.njk" %}
  <script>
    if (new URL(location.href).searchParams.has("render")) {
      document.body.classList.add("render-mode");
    }
  </script>
  <script src="{{ '/assets/js/fit-header.js' | url }}" defer></script>
  <script src="{{ '/assets/js/collage-editor.js' | url }}" defer></script>
</body>
</html>
